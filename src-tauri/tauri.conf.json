{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Staffy CNC",
  "version": "0.1.0",
  "identifier": "org.staffycnc.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Staffy CNC",
        "width": 1100,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Warner Media Design",
    "shortDescription": "Friendly CNC software for hobby machines",
    "license": "GPL-3.0-or-later"
  }
}